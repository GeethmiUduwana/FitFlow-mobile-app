<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle soft shadow for the central symbol -->
    <path
        android:pathData="M 33,57 L 43,57 L 49,43 L 57,69 L 63,52 L 67,57 L 77,57"
        android:strokeColor="#40000000"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- FitFlow Pulse & Flow Dynamic Wave -->
    <path
        android:pathData="M 31,54 L 42,54 L 48,38 L 56,66 L 63,47 L 68,54 L 79,54"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="54"
                android:endX="80"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E599" />
                <item android:offset="0.5" android:color="#00D2B4" />
                <item android:offset="1.0" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Flow Arc symbolizing AI energy & continuity -->
    <path
        android:pathData="M 40,32 C 48,27 62,27 70,33 C 73,35 75,39 74,43"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="30"
                android:endX="75"
                android:endY="43"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#818CF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing AI sparkle dot -->
    <path
        android:pathData="M 75,32 L 76.5,35 L 79.5,36.5 L 76.5,38 L 75,41 L 73.5,38 L 70.5,36.5 L 73.5,35 Z"
        android:fillColor="#38BDF8" />

    <!-- Bottom Anchor Arc -->
    <path
        android:pathData="M 68,76 C 60,81 48,81 38,75"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeColor="#3300E599"
        android:fillColor="#00000000" />
</vector>
